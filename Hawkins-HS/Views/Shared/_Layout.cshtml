<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hawkins Lisesi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Special+Gothic+Expanded+One&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#faf5f0',
                            100: '#f5ebe0',
                            200: '#e8d4c0',
                            300: '#d4b89d',
                            400: '#c09a78',
                            500: '#8B5A3C',
                            600: '#6B4423',
                            700: '#5a3a1e',
                            800: '#4a2f19',
                            900: '#3d2616',
                        },
                        cream: {
                            50: '#fefdfb',
                            100: '#fdfaf6',
                            200: '#F5F5DC',
                            300: '#f0f0cd',
                            400: '#eae9be',
                        },
                    }
                }
            }
        }
    </script>
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Styles -->
    <style>
        body {
            background: #f5f5f5;
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <!-- Navbar -->
    <nav class="bg-[#161618] text-[1.05rem] pt-5 pb-5  top-full flex-col overflow-visible">
        <div class="max-w-8xl pr-5 mx-auto lg:px-5">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-2">
                    <div class="bg-white p-1.5">
                        <img src="~/HawkinsLogo.svg" alt="Hawkins Lisesi Logo" class="h-10 w-10">
                    </div>
                    <span class="text-white font-serif text-lg">Hawkins <br /> High <br /> School</span>
                </a>
                
                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center space-x-8">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-controller="Home" asp-action="Index" class="text-white hover:text-gray-300 py-5 border-transparent transition-all font-['Special_Gothic_Expanded_One'] font-normal not-italic">
                            Ana Sayfa
                        </a>
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <!-- Yönetim Dropdown -->
                            <div class="absolute left-0 top-full z-[1] hidden flex-col overflow-visible bg-[#161618] text-[1.05rem] p-[1.3rem_4px_4px]">
                                <button class="text-white hover:text-gray-300 py-5 border-b-2 border-transparent group-hover:border-white transition-all font-light text-lg">
                                    Yönetim
                                </button>
                                <div class="absolute left-0 mt-0 w-64 bg-gray-900 border border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                    <a asp-controller="Admin" asp-action="Dashboard" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                        Dashboard
                                    </a>
                                    <a asp-controller="Students" asp-action="Index" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                        Öğrenciler
                                    </a>
                                    <a asp-controller="Teachers" asp-action="Index" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                        Öğretmenler
                                    </a>
                                    <a href="#" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                        Ayarlar
                                    </a>
                                </div>
                            </div>
                        }
                        
                        @if (User.IsInRole("Teacher") && !User.IsInRole("Admin"))
                        {
                            <a asp-controller="Students" asp-action="Index" class="text-white hover:text-gray-300 py-5 border-transparent transition-all font-['Special_Gothic_Expanded_One'] font-normal not-italic">
                                Öğrenciler
                            </a>
                        }
                        
                        @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
                        {
                           <div class="relative group">
                                <button class="text-white hover:text-gray-300 py-3 tracking-tight scale-95 transition-all font-['Special_Gothic_Expanded_One'] font-normal not-italic">
                                Akademik
                            </button>

                                <div class="absolute left-0 top-full w-64  bg-[#161618] border border-gray-700
                                        opacity-0 invisible
                                        group-hover:opacity-100 group-hover:visible
                                        transition-all duration-200 z-50 ">
                                <a asp-controller="Courses" asp-action="Index"
                                   class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Dersler
                                </a>
                                <a asp-controller="Exams" asp-action="Index"
                                   class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Sınavlar
                                </a>
                                <a asp-controller="Grades" asp-action="Index"
                                   class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Notlar
                                </a>
                                <a asp-controller="Attendance" asp-action="Index"
                                   class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Yoklama
                                </a>
                            </div>
                        </div>

                        }
                        
                        <!-- Program Dropdown -->
                        <div class="relative group">
                            <button class="text-white hover:text-gray-300 py-5 border-transparent transition-all font-['Special_Gothic_Expanded_One'] font-normal not-italic">
                                Program
                            </button>
                            <div class="absolute left-0 mt-0 w-64 bg-[#161618] border border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                <a asp-controller="Schedule" asp-action="Weekly" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Haftalık Program
                                </a>
                                <a href="#" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Ders Programı
                                </a>
                                <a href="#" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Sınav Takvimi
                                </a>
                            </div>
                        </div>

                        <!-- Kaynaklar Dropdown -->
                        <div class="relative group">
                            <button class="text-white hover:text-gray-300 py-5 border-transparent transition-all font-['Special_Gothic_Expanded_One'] font-normal not-italic">
                                Kaynaklar
                            </button>
                            <div class="absolute left-0 mt-0 w-64 bg-[#161618] border border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                <a href="#" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Kütüphane
                                </a>
                                <a asp-controller="Announcements" asp-action="Index" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Duyurular
                                </a>
                                <a href="#" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Öğrenci Rehberi
                                </a>
                                <a href="#" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Yardım
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <!-- User Menu -->
                <div class="flex items-center">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="relative group">
                            <button class="flex items-center space-x-2 text-white hover:text-gray-300 py-5 font-light text-lg">
                                <span>@User.Identity.Name</span>
                            </button>
                            <div class="absolute right-0 mt-0 w-48 bg-gray-900 border border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                <a asp-controller="Account" asp-action="Profile" class="block px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                    Profilim
                                </a>
                                <hr class="border-gray-700">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="w-full text-left px-6 py-3 text-gray-300 hover:text-white hover:bg-gray-800 transition-colors text-sm">
                                        Çıkış Yap
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="text-white hover:text-gray-300 py-5 border-b-2 border-transparent hover:border-white transition-all font-light text-lg">
                            Giriş Yap
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>
    
    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 p-4 rounded-r-lg shadow-md animate-pulse-slow">
                <div class="flex items-center">
                    <i class="bi bi-check-circle-fill text-green-500 text-2xl mr-3"></i>
                    <p class="text-green-800 font-medium">@TempData["Success"]</p>
                </div>
            </div>
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="bg-gradient-to-r from-red-50 to-pink-50 border-l-4 border-red-500 p-4 rounded-r-lg shadow-md animate-pulse-slow">
                <div class="flex items-center">
                    <i class="bi bi-exclamation-triangle-fill text-red-500 text-2xl mr-3"></i>
                    <p class="text-red-800 font-medium">@TempData["Error"]</p>
                </div>
            </div>
        </div>
    }
    
    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-black text-white mt-20 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <!-- School -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 text-gray-400">Okul</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#" class="text-gray-300 hover:text-white transition-colors">Hakkımızda</a></li>
                        <li><a href="#" class="text-gray-300 hover:text-white transition-colors">Yönetim</a></li>
                        <li><a href="#" class="text-gray-300 hover:text-white transition-colors">Misyon ve Vizyon</a></li>
                        <li><a href="#" class="text-gray-300 hover:text-white transition-colors">Kampüs</a></li>
                    </ul>
                </div>

                <!-- Academics -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 text-gray-400">Akademik</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a asp-controller="Courses" asp-action="Index" class="text-gray-300 hover:text-white transition-colors">Dersler</a></li>
                        <li><a asp-controller="Exams" asp-action="Index" class="text-gray-300 hover:text-white transition-colors">Sınavlar</a></li>
                        <li><a asp-controller="Schedule" asp-action="Weekly" class="text-gray-300 hover:text-white transition-colors">Program</a></li>
                        <li><a href="#" class="text-gray-300 hover:text-white transition-colors">Öğrenci Programları</a></li>
                    </ul>
                </div>

                <!-- Resources -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 text-gray-400">Kaynaklar</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#" class="text-gray-300 hover:text-white transition-colors">Kütüphane</a></li>
                        <li><a href="#" class="text-gray-300 hover:text-white transition-colors">Duyurular</a></li>
                        <li><a href="#" class="text-gray-300 hover:text-white transition-colors">Öğrenci Rehberi</a></li>
                        <li><a href="#" class="text-gray-300 hover:text-white transition-colors">Yardım Merkezi</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 text-gray-400">İletişim</h3>
                    <div class="space-y-2 text-sm text-gray-300">
                        <p>Hawkins, Indiana</p>
                        <p>(555) 123-4567</p>
                        <p>info@hawkinslisesi.edu</p>
                        <div class="flex space-x-3 mt-4">
                            <a href="#" class="text-gray-400 hover:text-white transition-colors">
                                <i class="bi bi-facebook text-xl"></i>
                            </a>
                            <a href="#" class="text-gray-400 hover:text-white transition-colors">
                                <i class="bi bi-twitter-x text-xl"></i>
                            </a>
                            <a href="#" class="text-gray-400 hover:text-white transition-colors">
                                <i class="bi bi-linkedin text-xl"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-t border-gray-800 mt-8 pt-6">
                <div class="flex flex-col md:flex-row justify-between items-center text-sm text-gray-400">
                    <p>&copy; 2026 Hawkins Lisesi. Tüm hakları saklıdır.</p>
                    <div class="flex space-x-4 mt-4 md:mt-0">
                        <a href="#" class="hover:text-white transition-colors">Gizlilik Politikası</a>
                        <a href="#" class="hover:text-white transition-colors">Kullanım Koşulları</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
