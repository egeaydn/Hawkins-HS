@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Hero Section -->
<div class="relative overflow-hidden bg-gradient-to-br from-primary-700 via-primary-600 to-primary-500 rounded-3xl shadow-2xl p-12 mb-12">
    <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full -mr-48 -mt-48 animate-float"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full -ml-32 -mb-32 animate-float" style="animation-delay: 1s;"></div>
    
    <div class="relative z-10 text-center">
        <div class="inline-block mb-6 bg-white/20 p-4 rounded-2xl animate-float">
            <img src="~/HawkinsLogo.svg" alt="Hawkins Lisesi Logo" class="h-20 w-20">
        </div>
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-4">
            Hawkins Lisesi
        </h1>
        <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
            Eğitimde Mükemmellik ve Yenilikçilik ile Geleceğin Liderlerini Yetiştiriyoruz
        </p>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a asp-controller="@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Teacher") ? "Teachers" : "Students")" 
               asp-action="Dashboard" 
               class="inline-flex items-center space-x-3 bg-white text-primary-700 px-8 py-4 rounded-xl font-semibold shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105 group">
                <i class="bi bi-speedometer2 text-2xl group-hover:rotate-12 transition-transform duration-300"></i>
                <span>Panele Git</span>
                <i class="bi bi-arrow-right group-hover:translate-x-2 transition-transform duration-300"></i>
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" 
               class="inline-flex items-center space-x-3 bg-white text-primary-700 px-8 py-4 rounded-xl font-semibold shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105 group">
                <i class="bi bi-box-arrow-in-right text-2xl"></i>
                <span>Giriş Yap</span>
                <i class="bi bi-arrow-right group-hover:translate-x-2 transition-transform duration-300"></i>
            </a>
        }
    </div>
</div>

<!-- Features Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
    <!-- Feature 1 -->
    <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 overflow-hidden">
        <div class="bg-gradient-to-br from-blue-500 to-blue-600 p-6">
            <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
                <i class="bi bi-book-fill text-white text-3xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">Ders Yönetimi</h3>
        </div>
        <div class="p-6">
            <p class="text-gray-600 leading-relaxed">
                Tüm derslerinizi tek bir platformdan kolayca yönetin. Program oluşturma, öğrenci kayıt ve ders materyalleri.
            </p>
            <div class="mt-4 flex items-center text-blue-600 font-semibold group-hover:translate-x-2 transition-transform duration-300">
                <span>Keşfet</span>
                <i class="bi bi-arrow-right ml-2"></i>
            </div>
        </div>
    </div>

    <!-- Feature 2 -->
    <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 overflow-hidden">
        <div class="bg-gradient-to-br from-purple-500 to-purple-600 p-6">
            <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
                <i class="bi bi-clipboard-check-fill text-white text-3xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">Sınav & Değerlendirme</h3>
        </div>
        <div class="p-6">
            <p class="text-gray-600 leading-relaxed">
                Dijital sınav oluşturma, not girişi ve otomatik değerlendirme sistemi ile zamanınızı verimli kullanın.
            </p>
            <div class="mt-4 flex items-center text-purple-600 font-semibold group-hover:translate-x-2 transition-transform duration-300">
                <span>Keşfet</span>
                <i class="bi bi-arrow-right ml-2"></i>
            </div>
        </div>
    </div>

    <!-- Feature 3 -->
    <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 overflow-hidden">
        <div class="bg-gradient-to-br from-green-500 to-green-600 p-6">
            <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
                <i class="bi bi-calendar-week-fill text-white text-3xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">Yoklama Takibi</h3>
        </div>
        <div class="p-6">
            <p class="text-gray-600 leading-relaxed">
                Öğrenci devamsızlığını dijital olarak takip edin. Detaylı raporlar ve bildirimlerle her şey kontrol altında.
            </p>
            <div class="mt-4 flex items-center text-green-600 font-semibold group-hover:translate-x-2 transition-transform duration-300">
                <span>Keşfet</span>
                <i class="bi bi-arrow-right ml-2"></i>
            </div>
        </div>
    </div>
</div>

<!-- Stats Section -->
@if (User.Identity?.IsAuthenticated ?? false)
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105">
            <div class="flex items-center justify-between mb-4">
                <i class="bi bi-people-fill text-5xl opacity-80"></i>
                <div class="w-12 h-12 bg-white/20 rounded-xl animate-pulse-slow"></div>
            </div>
            <h3 class="text-4xl font-bold mb-2">450+</h3>
            <p class="text-white/80">Öğrenci</p>
        </div>

        <div class="bg-gradient-to-br from-pink-500 to-rose-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105">
            <div class="flex items-center justify-between mb-4">
                <i class="bi bi-person-workspace text-5xl opacity-80"></i>
                <div class="w-12 h-12 bg-white/20 rounded-xl animate-pulse-slow"></div>
            </div>
            <h3 class="text-4xl font-bold mb-2">45+</h3>
            <p class="text-white/80">Öğretmen</p>
        </div>

        <div class="bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105">
            <div class="flex items-center justify-between mb-4">
                <i class="bi bi-book-half text-5xl opacity-80"></i>
                <div class="w-12 h-12 bg-white/20 rounded-xl animate-pulse-slow"></div>
            </div>
            <h3 class="text-4xl font-bold mb-2">120+</h3>
            <p class="text-white/80">Aktif Ders</p>
        </div>

        <div class="bg-gradient-to-br from-amber-500 to-orange-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105">
            <div class="flex items-center justify-between mb-4">
                <i class="bi bi-trophy-fill text-5xl opacity-80"></i>
                <div class="w-12 h-12 bg-white/20 rounded-xl animate-pulse-slow"></div>
            </div>
            <h3 class="text-4xl font-bold mb-2">95%</h3>
            <p class="text-white/80">Başarı Oranı</p>
        </div>
    </div>
}

<!-- Quick Links -->
<div class="bg-white rounded-2xl shadow-lg overflow-hidden">
    <div class="bg-gradient-to-r from-primary-700 to-primary-500 px-6 py-4">
        <h2 class="text-2xl font-bold text-white flex items-center">
            <i class="bi bi-link-45deg mr-3 text-3xl"></i>
            Hızlı Erişim
        </h2>
    </div>
    <div class="p-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
            {
                <a asp-controller="Courses" asp-action="Index" 
                   class="group flex flex-col items-center justify-center p-6 bg-gradient-to-br from-blue-50 to-blue-100 hover:from-blue-100 hover:to-blue-200 rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
                    <i class="bi bi-book-fill text-blue-600 text-4xl mb-3 group-hover:scale-110 transition-transform duration-300"></i>
                    <span class="text-gray-700 font-semibold">Dersler</span>
                </a>
                
                <a asp-controller="Exams" asp-action="Index" 
                   class="group flex flex-col items-center justify-center p-6 bg-gradient-to-br from-purple-50 to-purple-100 hover:from-purple-100 hover:to-purple-200 rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
                    <i class="bi bi-clipboard-check-fill text-purple-600 text-4xl mb-3 group-hover:scale-110 transition-transform duration-300"></i>
                    <span class="text-gray-700 font-semibold">Sınavlar</span>
                </a>
            }
            
            <a asp-controller="Schedule" asp-action="Weekly" 
               class="group flex flex-col items-center justify-center p-6 bg-gradient-to-br from-green-50 to-green-100 hover:from-green-100 hover:to-green-200 rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
                <i class="bi bi-calendar-week-fill text-green-600 text-4xl mb-3 group-hover:scale-110 transition-transform duration-300"></i>
                <span class="text-gray-700 font-semibold">Program</span>
            </a>
            
            <a asp-controller="Announcements" asp-action="Index" 
               class="group flex flex-col items-center justify-center p-6 bg-gradient-to-br from-amber-50 to-amber-100 hover:from-amber-100 hover:to-amber-200 rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
                <i class="bi bi-megaphone-fill text-amber-600 text-4xl mb-3 group-hover:scale-110 transition-transform duration-300"></i>
                <span class="text-gray-700 font-semibold">Duyurular</span>
            </a>
        </div>
    </div>
</div>
