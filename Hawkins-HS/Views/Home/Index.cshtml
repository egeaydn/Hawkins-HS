@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Hero Section -->
<div class="relative bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 border-b-4 border-primary-600">
    <div class="max-w-7xl mx-auto px-4 py-24">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
                <div class="inline-block mb-6 bg-white p-3">
                    <img src="~/HawkinsLogo.svg" alt="Hawkins Lisesi Logo" class="h-16 w-16">
                </div>
                <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
                    We are the<br/>
                    <span class="text-primary-500">Nation's First Line</span><br/>
                    of Defense
                </h1>
                <div class="w-1 h-24 bg-red-600 mb-6"></div>
                <p class="text-xl text-gray-300 mb-8 leading-relaxed">
                    Eğitimde Mükemmellik ve Yenilikçilik ile Geleceğin Liderlerini Yetiştiriyoruz
                </p>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Teacher") ? "Teachers" : "Students")" 
                       asp-action="Dashboard" 
                       class="inline-block bg-red-600 hover:bg-red-700 text-white px-8 py-4 font-bold uppercase tracking-wider transition-colors">
                        Panele Git
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" 
                       class="inline-block bg-red-600 hover:bg-red-700 text-white px-8 py-4 font-bold uppercase tracking-wider transition-colors">
                        Giriş Yap
                    </a>
                }
            </div>
            <div class="hidden lg:block">
                <div class="bg-gray-800 border border-gray-700 p-8">
                    <img src="~/HawkinsLogo.svg" alt="Building" class="w-full h-96 object-cover opacity-50">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Grid -->
<div class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-1">
        <!-- Feature 1 -->
        <div class="bg-white border-l-4 border-blue-600 p-8 hover:bg-gray-50 transition-colors">
            <div class="flex items-start space-x-4">
                <div class="bg-blue-600 p-3">
                    <i class="bi bi-book-fill text-white text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Ders Yönetimi</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Tüm derslerinizi tek bir platformdan kolayca yönetin. Program oluşturma, öğrenci kayıt ve ders materyalleri.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white border-l-4 border-purple-600 p-8 hover:bg-gray-50 transition-colors">
            <div class="flex items-start space-x-4">
                <div class="bg-purple-600 p-3">
                    <i class="bi bi-clipboard-check-fill text-white text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Sınav & Değerlendirme</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Dijital sınav oluşturma, not girişi ve otomatik değerlendirme sistemi ile zamanınızı verimli kullanın.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white border-l-4 border-green-600 p-8 hover:bg-gray-50 transition-colors">
            <div class="flex items-start space-x-4">
                <div class="bg-green-600 p-3">
                    <i class="bi bi-calendar-week-fill text-white text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Yoklama Takibi</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Öğrenci devamsızlığını dijital olarak takip edin. Detaylı raporlar ve bildirimlerle her şey kontrol altında.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stats Section -->
@if (User.Identity?.IsAuthenticated ?? false)
{
    <div class="bg-gray-100 py-16">
        <div class="max-w-7xl mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-1">
                <div class="bg-white p-8 text-center border-r border-gray-200">
                    <div class="text-indigo-600 mb-4">
                        <i class="bi bi-people-fill text-5xl"></i>
                    </div>
                    <h3 class="text-4xl font-bold text-gray-900 mb-2">450+</h3>
                    <p class="text-gray-600 uppercase text-sm tracking-wider">Öğrenci</p>
                </div>

                <div class="bg-white p-8 text-center border-r border-gray-200">
                    <div class="text-pink-600 mb-4">
                        <i class="bi bi-person-workspace text-5xl"></i>
                    </div>
                    <h3 class="text-4xl font-bold text-gray-900 mb-2">45+</h3>
                    <p class="text-gray-600 uppercase text-sm tracking-wider">Öğretmen</p>
                </div>

                <div class="bg-white p-8 text-center border-r border-gray-200">
                    <div class="text-cyan-600 mb-4">
                        <i class="bi bi-book-half text-5xl"></i>
                    </div>
                    <h3 class="text-4xl font-bold text-gray-900 mb-2">120+</h3>
                    <p class="text-gray-600 uppercase text-sm tracking-wider">Aktif Ders</p>
                </div>

                <div class="bg-white p-8 text-center">
                    <div class="text-amber-600 mb-4">
                        <i class="bi bi-trophy-fill text-5xl"></i>
                    </div>
                    <h3 class="text-4xl font-bold text-gray-900 mb-2">95%</h3>
                    <p class="text-gray-600 uppercase text-sm tracking-wider">Başarı Oranı</p>
                </div>
            </div>
        </div>
    </div>
}

<!-- Quick Links -->
<!-- Quick Links -->
<div class="max-w-7xl mx-auto px-4 py-16">
    <div class="bg-white border border-gray-200">
        <div class="bg-gray-900 px-6 py-4 border-b-4 border-red-600">
            <h2 class="text-2xl font-bold text-white uppercase tracking-wider">
                Hızlı Erişim
            </h2>
        </div>
        <div class="p-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-1">
                @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                {
                    <a asp-controller="Courses" asp-action="Index" 
                       class="flex flex-col items-center justify-center p-8 bg-gray-50 hover:bg-blue-50 border border-gray-200 transition-colors group">
                        <i class="bi bi-book-fill text-blue-600 text-4xl mb-3"></i>
                        <span class="text-gray-700 font-semibold uppercase text-sm">Dersler</span>
                    </a>
                    
                    <a asp-controller="Exams" asp-action="Index" 
                       class="flex flex-col items-center justify-center p-8 bg-gray-50 hover:bg-purple-50 border border-gray-200 transition-colors group">
                        <i class="bi bi-clipboard-check-fill text-purple-600 text-4xl mb-3"></i>
                        <span class="text-gray-700 font-semibold uppercase text-sm">Sınavlar</span>
                    </a>
                }
                
                <a asp-controller="Schedule" asp-action="Weekly" 
                   class="flex flex-col items-center justify-center p-8 bg-gray-50 hover:bg-green-50 border border-gray-200 transition-colors group">
                    <i class="bi bi-calendar-week-fill text-green-600 text-4xl mb-3"></i>
                    <span class="text-gray-700 font-semibold uppercase text-sm">Program</span>
                </a>
                
                <a asp-controller="Announcements" asp-action="Index" 
                   class="flex flex-col items-center justify-center p-8 bg-gray-50 hover:bg-amber-50 border border-gray-200 transition-colors group">
                    <i class="bi bi-megaphone-fill text-amber-600 text-4xl mb-3"></i>
                    <span class="text-gray-700 font-semibold uppercase text-sm">Duyurular</span>
                </a>
            </div>
        </div>
    </div>
</div>
