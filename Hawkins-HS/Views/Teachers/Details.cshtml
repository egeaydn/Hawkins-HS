@model Hawkins_HS.Models.Teacher

@{
    ViewData["Title"] = "Öğretmen Detayı";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">👨‍🏫 Öğretmen Bilgileri</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="display-1">👤</div>
                        <h4 class="mt-3">@Model.ApplicationUser.FullName</h4>
                        <p class="text-muted">@Model.EmployeeNumber</p>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <small class="text-muted d-block">Email</small>
                        <strong>@Model.ApplicationUser.Email</strong>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block">Telefon</small>
                        <strong>@(Model.ApplicationUser.PhoneNumber ?? "Belirtilmemiş")</strong>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block">Bölüm</small>
                        <span class="badge bg-primary fs-6">@Model.Department</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">📚 Verdiği Dersler (@Model.Courses.Count)</h5>
                </div>
                <div class="card-body">
                    @if (Model.Courses.Any())
                    {
                        <div class="list-group">
                            @foreach (var course in Model.Courses)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1">@course.Title</h6>
                                            <p class="mb-1 text-muted">@course.Code - @course.Credits Kredi</p>
                                            <small>@course.Enrollments.Count öğrenci kayıtlı</small>
                                        </div>
                                        <div>
                                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" 
                                               class="btn btn-sm btn-outline-primary">Detay</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">Henüz ders atanmamış</p>
                    }
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header bg-white">
                    <h5 class="mb-0">📊 İstatistikler</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-primary">@Model.Courses.Count</h3>
                                    <p class="mb-0 text-muted">Verdiği Ders</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-success">@Model.Courses.Sum(c => c.Enrollments.Count)</h3>
                                    <p class="mb-0 text-muted">Toplam Öğrenci</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-info">@Model.Courses.Sum(c => c.Exams.Count)</h3>
                                    <p class="mb-0 text-muted">Toplam Sınav</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Öğretmen Listesine Dön</a>
    </div>
</div>
