@model IEnumerable<Hawkins_HS.Models.ClassSchedule>

@{
    ViewData["Title"] = "Haftalık Ders Programı";
    var days = new[] { "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi", "Pazar" };
    var hours = Enumerable.Range(8, 12).Select(h => new TimeSpan(h, 0, 0)).ToList(); // 08:00-19:00
    
    // Sonraki dersi bul
    var now = DateTime.Now;
    var currentDay = now.ToString("dddd", new System.Globalization.CultureInfo("tr-TR"));
    var currentTime = now.TimeOfDay;
    
    var upcomingClass = Model
        .Where(s => {
            var dayIndex = Array.IndexOf(days, s.Day);
            var currentDayIndex = Array.IndexOf(days, currentDay);
            return dayIndex > currentDayIndex || (dayIndex == currentDayIndex && s.StartTime > currentTime);
        })
        .OrderBy(s => Array.IndexOf(days, s.Day))
        .ThenBy(s => s.StartTime)
        .FirstOrDefault();
}

<style>
    @@keyframes pulse-glow {
        0%, 100% { box-shadow: 0 0 20px rgba(239, 68, 68, 0.5); }
        50% { box-shadow: 0 0 30px rgba(239, 68, 68, 0.8); }
    }
    .upcoming-class { animation: pulse-glow 2s infinite; }
</style>

<!-- Header -->
<div class="bg-gradient-to-r from-primary-600 to-primary-700 text-white py-12 px-4 sm:px-6 lg:px-8 mb-8 rounded-2xl shadow-xl">
    <div class="max-w-7xl mx-auto">
        <h1 class="text-4xl font-bold mb-2 animate-pulse-slow">📅 Haftalık Ders Programım</h1>
        <p class="text-primary-100">Tüm derslerinizin haftalık takvimi</p>
    </div>
</div>

<!-- Upcoming Class Alert -->
@if (upcomingClass != null)
{
    <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-2xl p-6 mb-8 shadow-xl text-white">
        <div class="flex items-center">
            <div class="text-6xl mr-6 animate-bounce">⏰</div>
            <div class="flex-1">
                <h5 class="text-lg font-semibold mb-1 text-purple-100">Sonraki Dersiniz</h5>
                <h2 class="text-3xl font-bold mb-3">@upcomingClass.Course.Title</h2>
                <div class="flex flex-wrap gap-3">
                    <span class="bg-white text-purple-600 px-4 py-2 rounded-lg font-semibold">
                        <i class="bi bi-calendar3"></i> @upcomingClass.Day
                    </span>
                    <span class="bg-white text-purple-600 px-4 py-2 rounded-lg font-semibold">
                        <i class="bi bi-clock"></i> @($"{upcomingClass.StartTime.Hours:D2}:{upcomingClass.StartTime.Minutes:D2}") - @($"{upcomingClass.EndTime.Hours:D2}:{upcomingClass.EndTime.Minutes:D2}")
                    </span>
                    <span class="bg-white text-purple-600 px-4 py-2 rounded-lg font-semibold">
                        <i class="bi bi-geo-alt-fill"></i> @upcomingClass.Room
                    </span>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Any())
{
    <!-- Schedule Table -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-8">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="bg-gradient-to-r from-primary-600 to-primary-700">
                        <th class="px-4 py-4 text-white font-bold text-center">
                            <i class="bi bi-clock-history"></i> Saat
                        </th>
                        @foreach (var day in days)
                        {
                            var isToday = day == currentDay;
                            <th class="px-4 py-4 text-center @(isToday ? "bg-amber-500" : "text-white")">
                                @if (isToday)
                                {
                                    <span class="block bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold mb-1">BUGÜN</span>
                                }
                                <span class="@(isToday ? "text-white font-bold" : "font-semibold")">@day</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hour in hours)
                    {
                        <tr class="border-b border-gray-200">
                            <td class="bg-primary-50 px-4 py-3 text-center font-bold text-primary-700">
                                @($"{hour.Hours:D2}:{hour.Minutes:D2}")
                            </td>
                            @foreach (var day in days)
                            {
                                var schedules = Model.Where(s => 
                                    s.Day == day && 
                                    s.StartTime <= hour && 
                                    s.EndTime > hour
                                ).ToList();
                                
                                var isToday = day == currentDay;
                                var isCurrentHour = isToday && hour <= currentTime && hour.Add(TimeSpan.FromHours(1)) > currentTime;

                                <td class="px-2 py-2 min-h-[100px] @(isToday ? "bg-amber-50" : "") @(isCurrentHour ? "bg-yellow-100" : "")">
                                    @foreach (var schedule in schedules)
                                    {
                                        var isUpcoming = schedule == upcomingClass;
                                        <div class="@(isUpcoming ? "upcoming-class" : "") bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl p-3 text-white mb-2 hover:scale-105 transition-transform">
                                            <div class="mb-2">
                                                <h6 class="font-bold text-sm mb-1">@schedule.Course.Title</h6>
                                                <span class="inline-block bg-white/20 px-2 py-1 rounded text-xs">@schedule.Course.Code</span>
                                            </div>
                                            <div class="space-y-1 text-xs">
                                                <div class="flex items-center">
                                                    <i class="bi bi-clock mr-2"></i>
                                                    <span>@($"{schedule.StartTime.Hours:D2}:{schedule.StartTime.Minutes:D2}") - @($"{schedule.EndTime.Hours:D2}:{schedule.EndTime.Minutes:D2}")</span>
                                                </div>
                                                <div class="flex items-center font-semibold">
                                                    <i class="bi bi-geo-alt-fill mr-2"></i>
                                                    <span>@schedule.Room</span>
                                                </div>
                                                @if (schedule.Course.Teacher != null)
                                                {
                                                    <div class="flex items-center">
                                                        <i class="bi bi-person-circle mr-2"></i>
                                                        <span>@schedule.Course.Teacher.ApplicationUser.FullName</span>
                                                    </div>
                                                }
                                            </div>
                                            @if (isUpcoming)
                                            {
                                                <div class="mt-2">
                                                    <span class="inline-block bg-red-500 text-white px-2 py-1 rounded text-xs font-bold animate-pulse">
                                                        <i class="bi bi-arrow-right-circle-fill"></i> SONRAKİ DERS
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl p-6 text-white text-center hover:scale-105 transition-transform shadow-lg">
            <i class="bi bi-book-fill text-6xl mb-3 opacity-80"></i>
            <h3 class="text-4xl font-bold mb-1">@Model.Select(s => s.CourseId).Distinct().Count()</h3>
            <p class="text-purple-100">Toplam Ders</p>
        </div>
        <div class="bg-gradient-to-br from-pink-500 to-rose-600 rounded-2xl p-6 text-white text-center hover:scale-105 transition-transform shadow-lg">
            <i class="bi bi-clock-fill text-6xl mb-3 opacity-80"></i>
            <h3 class="text-4xl font-bold mb-1">@Model.Sum(s => (s.EndTime - s.StartTime).TotalHours).ToString("0")</h3>
            <p class="text-pink-100">Saat / Hafta</p>
        </div>
        <div class="bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl p-6 text-white text-center hover:scale-105 transition-transform shadow-lg">
            <i class="bi bi-calendar-check-fill text-6xl mb-3 opacity-80"></i>
            <h3 class="text-4xl font-bold mb-1">@Model.Select(s => s.Day).Distinct().Count()</h3>
            <p class="text-cyan-100">Aktif Gün</p>
        </div>
    </div>
}
else
{
    <div class="bg-amber-50 border-l-4 border-amber-500 rounded-xl p-8 text-center max-w-2xl mx-auto">
        <div class="text-6xl mb-4 opacity-30">📅</div>
        <h4 class="text-2xl font-bold text-gray-800 mb-2">Henüz ders programınız oluşturulmamış</h4>
        <p class="text-gray-600">Derslerinize program eklendiğinde burada görünecektir.</p>
    </div>
}
