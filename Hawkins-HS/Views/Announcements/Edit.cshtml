@model Hawkins_HS.ViewModels.AnnouncementViewModel

@{
    ViewData["Title"] = "Duyuru Düzenle";
    var audienceOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = "Tüm Kullanıcılar", Value = "All" },
        new SelectListItem { Text = "Öğrenciler", Value = "Students" },
        new SelectListItem { Text = "Öğretmenler", Value = "Teachers" },
        new SelectListItem { Text = "9. Sınıf", Value = "Class:9" },
        new SelectListItem { Text = "10. Sınıf", Value = "Class:10" },
        new SelectListItem { Text = "11. Sınıf", Value = "Class:11" },
        new SelectListItem { Text = "12. Sınıf", Value = "Class:12" }
    };
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">✏️ Duyuru Düzenle</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Duyuru Başlığı</label>
                            <input asp-for="Title" class="form-control" placeholder="Duyuru başlığını girin" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Body" class="form-label">İçerik</label>
                            <textarea asp-for="Body" class="form-control" rows="6" placeholder="Duyuru içeriğini girin..."></textarea>
                            <span asp-validation-for="Body" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Audience" class="form-label">Hedef Kitle</label>
                            <select asp-for="Audience" class="form-select" asp-items="audienceOptions">
                                <option value="">-- Hedef Kitle Seçin --</option>
                            </select>
                            <span asp-validation-for="Audience" class="text-danger"></span>
                            <small class="form-text text-muted">Bu duyuruyu kimler görecek?</small>
                        </div>
                        
                        <div class="mb-3 form-check">
                            <input asp-for="IsImportant" class="form-check-input" type="checkbox" />
                            <label asp-for="IsImportant" class="form-check-label">
                                Önemli Duyuru (Kırmızı renkle vurgulanır)
                            </label>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">İptal</a>
                            <button type="submit" class="btn btn-warning">Değişiklikleri Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
