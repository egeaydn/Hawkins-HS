@model Hawkins_HS.ViewModels.AnnouncementViewModel

@{
    ViewData["Title"] = "Duyuru Detayı";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow @(Model.IsImportant ? "border-danger border-3" : "")">
                <div class="card-header @(Model.IsImportant ? "bg-danger" : "bg-primary") text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            @if (Model.IsImportant)
                            {
                                <span class="badge bg-white text-danger me-2">⚠️ ÖNEMLİ</span>
                            }
                            @Model.Title
                        </h4>
                        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                        {
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light btn-sm">
                                    <i class="bi bi-pencil"></i> Düzenle
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm" 
                                       onclick="return confirm('Bu duyuruyu silmek istediğinizden emin misiniz?')">
                                        <i class="bi bi-trash"></i> Sil
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <small class="text-muted d-block">👤 Yayınlayan</small>
                            <strong>@Model.CreatorName</strong>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">📅 Tarih</small>
                            <strong>@Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</strong>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">👥 Hedef Kitle</small>
                            <strong>
                                @if (Model.Audience == "All")
                                {
                                    <span class="badge bg-primary">Herkes</span>
                                }
                                else if (Model.Audience == "Students")
                                {
                                    <span class="badge bg-success">Öğrenciler</span>
                                }
                                else if (Model.Audience == "Teachers")
                                {
                                    <span class="badge bg-info">Öğretmenler</span>
                                }
                                else if (Model.Audience.StartsWith("Class:"))
                                {
                                    <span class="badge bg-warning">@Model.Audience.Replace("Class:", "") - Sınıfı</span>
                                }
                            </strong>
                        </div>
                    </div>

                    <hr />

                    <div class="announcement-body mt-4">
                        <p style="white-space: pre-wrap; font-size: 1.1rem; line-height: 1.8;">@Model.Body</p>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Duyurulara Geri Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
