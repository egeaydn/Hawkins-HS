@model Hawkins_HS.ViewModels.AnnouncementViewModel

@{
    ViewData["Title"] = "Duyuru Detayı";
}

<div class="max-w-3xl mx-auto px-4 py-8">

    <!-- Geri Dön + Başlık Satırı -->
    <div class="flex items-center justify-between mb-6">
        <a asp-action="Index"
           class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-800 transition-colors">
            <i class="bi bi-arrow-left"></i> Duyurulara Geri Dön
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
        {
            <div class="flex items-center gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium bg-amber-100 hover:bg-amber-200 text-amber-700 rounded-xl transition-colors">
                    <i class="bi bi-pencil"></i> Düzenle
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Delete" asp-route-id="@Model.Id"
                       onclick="return confirm('Bu duyuruyu silmek istediğinizden emin misiniz?')"
                       class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium bg-red-100 hover:bg-red-200 text-red-700 rounded-xl transition-colors">
                        <i class="bi bi-trash"></i> Sil
                    </a>
                }
            </div>
        }
    </div>

    <!-- Kart -->
    <div class="bg-white rounded-2xl shadow-sm border @(Model.IsImportant ? "border-red-300" : "border-gray-100") overflow-hidden">

        <!-- Üst Şerit -->
        <div class="h-1.5 @(Model.IsImportant ? "bg-gradient-to-r from-red-500 to-red-400" : "bg-gradient-to-r from-primary-600 to-primary-400")"></div>

        <div class="p-8">
            <!-- Önemli Rozeti + Başlık -->
            <div class="mb-6">
                @if (Model.IsImportant)
                {
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold bg-red-100 text-red-700 px-3 py-1 rounded-full mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i> ÖNEMLİ DUYURU
                    </span>
                }
                <h1 class="text-2xl font-bold text-gray-900 leading-snug">@Model.Title</h1>
            </div>

            <!-- Meta Bilgiler -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6 p-4 bg-gray-50 rounded-xl">
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Yayınlayan</p>
                    <p class="text-sm font-semibold text-gray-800 flex items-center gap-1.5">
                        <i class="bi bi-person-circle text-primary-500"></i> @Model.CreatorName
                    </p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Tarih</p>
                    <p class="text-sm font-semibold text-gray-800 flex items-center gap-1.5">
                        <i class="bi bi-calendar3 text-primary-500"></i> @Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")
                    </p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Hedef Kitle</p>
                    @if (Model.Audience == "All")
                    {
                        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-blue-100 text-blue-700 px-2.5 py-1 rounded-full">
                            <i class="bi bi-globe"></i> Herkes
                        </span>
                    }
                    else if (Model.Audience == "Students")
                    {
                        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-green-100 text-green-700 px-2.5 py-1 rounded-full">
                            <i class="bi bi-mortarboard"></i> Öğrenciler
                        </span>
                    }
                    else if (Model.Audience == "Teachers")
                    {
                        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-cyan-100 text-cyan-700 px-2.5 py-1 rounded-full">
                            <i class="bi bi-person-badge"></i> Öğretmenler
                        </span>
                    }
                    else if (Model.Audience.StartsWith("Class:"))
                    {
                        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-amber-100 text-amber-700 px-2.5 py-1 rounded-full">
                            <i class="bi bi-door-open"></i> @Model.Audience.Replace("Class:", ""). Sınıf
                        </span>
                    }
                </div>
            </div>

            <!-- İçerik -->
            <div class="prose prose-gray max-w-none">
                <p class="text-gray-700 leading-relaxed whitespace-pre-wrap text-base">@Model.Body</p>
            </div>
        </div>
    </div>
</div>
