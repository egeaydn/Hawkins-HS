@model IEnumerable<Hawkins_HS.ViewModels.AnnouncementViewModel>

@{
    ViewData["Title"] = "Duyurular";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📢 Duyurular</h2>
        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
        {
            <a asp-action="Create" class="btn btn-primary">Yeni Duyuru Oluştur</a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var announcement in Model.OrderByDescending(a => a.CreatedAt))
            {
                <div class="col-12 mb-3">
                    <div class="card shadow-sm @(announcement.IsImportant ? "border-danger" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h5 class="card-title">
                                        @if (announcement.IsImportant)
                                        {
                                            <span class="badge bg-danger me-2">ÖNEMLİ</span>
                                        }
                                        @announcement.Title
                                    </h5>
                                    
                                    <p class="card-text">@announcement.Body</p>
                                    
                                    <div class="d-flex gap-3 text-muted small">
                                        <span>👤 @announcement.CreatorName</span>
                                        <span>📅 @announcement.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
                                        <span>👥 @announcement.Audience</span>
                                    </div>
                                </div>
                                
                                @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                                {
                                    <div class="btn-group ms-3">
                                        <a asp-action="Details" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                                        <a asp-action="Edit" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu duyuruyu silmek istediğinizden emin misiniz?')">Sil</a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <h4>Henüz duyuru yok</h4>
            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
            {
                <p>Yeni bir duyuru oluşturmak için yukarıdaki butona tıklayın.</p>
            }
        </div>
    }
</div>
