@model dynamic

@{
    ViewData["Title"] = "Yönetim Paneli";
}

<!-- Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold text-gray-800 mb-2">⚙️ Yönetim Paneli</h1>
    <p class="text-gray-600">Hawkins Lisesi sistem yönetimi</p>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Students -->
    <div class="group bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105">
        <div class="flex items-center justify-between mb-4">
            <div>
                <p class="text-blue-100 text-sm font-medium uppercase tracking-wide">Öğrenciler</p>
                <h3 class="text-4xl font-bold mt-2">@Model.TotalStudents</h3>
            </div>
            <div class="bg-white/20 p-4 rounded-xl">
                <i class="bi bi-people-fill text-4xl"></i>
            </div>
        </div>
        <a asp-controller="Students" asp-action="Index" class="flex items-center text-blue-100 hover:text-white text-sm font-medium group-hover:translate-x-2 transition-transform duration-200">
            <span>Detaylar</span>
            <i class="bi bi-arrow-right ml-2"></i>
        </a>
    </div>

    <!-- Teachers -->
    <div class="group bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105">
        <div class="flex items-center justify-between mb-4">
            <div>
                <p class="text-emerald-100 text-sm font-medium uppercase tracking-wide">Öğretmenler</p>
                <h3 class="text-4xl font-bold mt-2">@Model.TotalTeachers</h3>
            </div>
            <div class="bg-white/20 p-4 rounded-xl">
                <i class="bi bi-person-workspace text-4xl"></i>
            </div>
        </div>
        <a asp-controller="Teachers" asp-action="Index" class="flex items-center text-emerald-100 hover:text-white text-sm font-medium group-hover:translate-x-2 transition-transform duration-200">
            <span>Detaylar</span>
            <i class="bi bi-arrow-right ml-2"></i>
        </a>
    </div>

    <!-- Courses -->
    <div class="group bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105">
        <div class="flex items-center justify-between mb-4">
            <div>
                <p class="text-purple-100 text-sm font-medium uppercase tracking-wide">Dersler</p>
                <h3 class="text-4xl font-bold mt-2">@Model.TotalCourses</h3>
            </div>
            <div class="bg-white/20 p-4 rounded-xl">
                <i class="bi bi-book-fill text-4xl"></i>
            </div>
        </div>
        <a asp-controller="Courses" asp-action="Index" class="flex items-center text-purple-100 hover:text-white text-sm font-medium group-hover:translate-x-2 transition-transform duration-200">
            <span>Detaylar</span>
            <i class="bi bi-arrow-right ml-2"></i>
        </a>
    </div>

    <!-- Exams -->
    <div class="group bg-gradient-to-br from-amber-500 to-amber-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105">
        <div class="flex items-center justify-between mb-4">
            <div>
                <p class="text-amber-100 text-sm font-medium uppercase tracking-wide">Sınavlar</p>
                <h3 class="text-4xl font-bold mt-2">@Model.TotalExams</h3>
            </div>
            <div class="bg-white/20 p-4 rounded-xl">
                <i class="bi bi-clipboard-check-fill text-4xl"></i>
            </div>
        </div>
        <a asp-controller="Exams" asp-action="Index" class="flex items-center text-amber-100 hover:text-white text-sm font-medium group-hover:translate-x-2 transition-transform duration-200">
            <span>Detaylar</span>
            <i class="bi bi-arrow-right ml-2"></i>
        </a>
    </div>
</div>

<!-- Charts and Lists -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Recent Students -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-primary-700 to-primary-500 px-6 py-4 flex items-center justify-between">
            <h3 class="text-xl font-bold text-white flex items-center">
                <i class="bi bi-people-fill mr-3"></i>
                Son Kayıtlı Öğrenciler
            </h3>
            <a asp-controller="Students" asp-action="Create" class="bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-lg transition-all duration-200 text-sm font-medium">
                <i class="bi bi-plus-circle mr-2"></i>Yeni
            </a>
        </div>
        <div class="p-6">
            @if (Model.RecentStudents != null && Model.RecentStudents.Count > 0)
            {
                <div class="space-y-3">
                    @foreach (var student in Model.RecentStudents)
                    {
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors duration-200">
                            <div class="flex items-center space-x-4">
                                <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold text-lg">
                                    @student.ApplicationUser.FullName.Substring(0, 1)
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-800">@student.ApplicationUser.FullName</p>
                                    <p class="text-sm text-gray-500">@student.StudentNumber | @student.ClassName</p>
                                </div>
                            </div>
                            <a asp-controller="Students" asp-action="Details" asp-route-id="@student.Id" class="text-blue-600 hover:text-blue-700">
                                <i class="bi bi-arrow-right-circle-fill text-2xl"></i>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-gray-500 text-center py-8">Henüz öğrenci kaydı yok</p>
            }
        </div>
    </div>

    <!-- Recent Courses -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-purple-600 to-purple-500 px-6 py-4 flex items-center justify-between">
            <h3 class="text-xl font-bold text-white flex items-center">
                <i class="bi bi-book-fill mr-3"></i>
                Son Eklenen Dersler
            </h3>
            <a asp-controller="Courses" asp-action="Create" class="bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-lg transition-all duration-200 text-sm font-medium">
                <i class="bi bi-plus-circle mr-2"></i>Yeni
            </a>
        </div>
        <div class="p-6">
            @if (Model.RecentCourses != null && Model.RecentCourses.Count > 0)
            {
                <div class="space-y-3">
                    @foreach (var course in Model.RecentCourses)
                    {
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors duration-200">
                            <div>
                                <p class="font-semibold text-gray-800">@course.Title</p>
                                <div class="flex items-center space-x-3 mt-1">
                                    <span class="px-3 py-1 bg-purple-100 text-purple-700 text-xs font-medium rounded-full">@course.Code</span>
                                    <span class="text-sm text-gray-500">@course.Credits Kredi</span>
                                </div>
                            </div>
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="text-purple-600 hover:text-purple-700">
                                <i class="bi bi-arrow-right-circle-fill text-2xl"></i>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-gray-500 text-center py-8">Henüz ders eklenmemiş</p>
            }
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="bg-white rounded-2xl shadow-lg p-6">
    <h3 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
        <i class="bi bi-lightning-charge-fill text-amber-500 mr-3"></i>
        Hızlı İşlemler
    </h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a asp-controller="Students" asp-action="Create" class="group flex flex-col items-center p-6 bg-gradient-to-br from-blue-50 to-blue-100 hover:from-blue-100 hover:to-blue-200 rounded-xl transition-all duration-300 hover:shadow-lg">
            <i class="bi bi-person-plus-fill text-blue-600 text-3xl mb-3 group-hover:scale-110 transition-transform duration-300"></i>
            <span class="text-gray-700 font-semibold text-sm text-center">Öğrenci Ekle</span>
        </a>
        <a asp-controller="Teachers" asp-action="Create" class="group flex flex-col items-center p-6 bg-gradient-to-br from-emerald-50 to-emerald-100 hover:from-emerald-100 hover:to-emerald-200 rounded-xl transition-all duration-300 hover:shadow-lg">
            <i class="bi bi-person-workspace text-emerald-600 text-3xl mb-3 group-hover:scale-110 transition-transform duration-300"></i>
            <span class="text-gray-700 font-semibold text-sm text-center">Öğretmen Ekle</span>
        </a>
        <a asp-controller="Courses" asp-action="Create" class="group flex flex-col items-center p-6 bg-gradient-to-br from-purple-50 to-purple-100 hover:from-purple-100 hover:to-purple-200 rounded-xl transition-all duration-300 hover:shadow-lg">
            <i class="bi bi-book-fill text-purple-600 text-3xl mb-3 group-hover:scale-110 transition-transform duration-300"></i>
            <span class="text-gray-700 font-semibold text-sm text-center">Ders Ekle</span>
        </a>
        <a asp-controller="Exams" asp-action="Create" class="group flex flex-col items-center p-6 bg-gradient-to-br from-amber-50 to-amber-100 hover:from-amber-100 hover:to-amber-200 rounded-xl transition-all duration-300 hover:shadow-lg">
            <i class="bi bi-clipboard-plus-fill text-amber-600 text-3xl mb-3 group-hover:scale-110 transition-transform duration-300"></i>
            <span class="text-gray-700 font-semibold text-sm text-center">Sınav Ekle</span>
        </a>
    </div>
</div>
