@model Hawkins_HS.Models.Student

@{
    ViewData["Title"] = "Öğrenci Dashboard";
    var upcomingExams = ViewBag.UpcomingExams as List<Hawkins_HS.Models.Exam>;
}

<!-- Header -->
<div class="bg-gradient-to-r from-primary-600 to-primary-700 text-white py-12 px-4 sm:px-6 lg:px-8 mb-8 rounded-2xl shadow-xl">
    <div class="max-w-7xl mx-auto">
        <h1 class="text-4xl font-bold mb-2 animate-pulse-slow">Hoş Geldiniz, @Model.ApplicationUser.FullName! 👋</h1>
        <p class="text-primary-100 text-lg">@Model.StudentNumber | @Model.ClassName</p>
    </div>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Enrolled Courses -->
    <div class="group bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl shadow-lg p-6 text-white hover:scale-105 hover:shadow-2xl transition-all duration-300">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-blue-100 text-sm font-medium mb-1">Kayıtlı Ders</p>
                <h3 class="text-4xl font-bold">@Model.Enrollments.Count</h3>
            </div>
            <div class="text-6xl opacity-20 group-hover:opacity-30 transition-opacity">📚</div>
        </div>
        <div class="mt-4 pt-4 border-t border-blue-400">
            <a asp-controller="Courses" asp-action="Index" class="text-sm font-medium hover:text-blue-100 transition-colors">
                Derslerime Git →
            </a>
        </div>
    </div>

    <!-- Upcoming Exams -->
    <div class="group bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl shadow-lg p-6 text-white hover:scale-105 hover:shadow-2xl transition-all duration-300">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-emerald-100 text-sm font-medium mb-1">Yaklaşan Sınav</p>
                <h3 class="text-4xl font-bold">@(upcomingExams?.Count ?? 0)</h3>
            </div>
            <div class="text-6xl opacity-20 group-hover:opacity-30 transition-opacity">📝</div>
        </div>
        <div class="mt-4 pt-4 border-t border-emerald-400">
            <a asp-controller="Exams" asp-action="Index" class="text-sm font-medium hover:text-emerald-100 transition-colors">
                Sınavları Gör →
            </a>
        </div>
    </div>

    <!-- Grades -->
    <div class="group bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl shadow-lg p-6 text-white hover:scale-105 hover:shadow-2xl transition-all duration-300">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-purple-100 text-sm font-medium mb-1">Alınan Not</p>
                <h3 class="text-4xl font-bold">@Model.Grades.Count</h3>
            </div>
            <div class="text-6xl opacity-20 group-hover:opacity-30 transition-opacity">🎯</div>
        </div>
        <div class="mt-4 pt-4 border-t border-purple-400">
            <a asp-action="MyGrades" class="text-sm font-medium hover:text-purple-100 transition-colors">
                Notlarımı Gör →
            </a>
        </div>
    </div>

    <!-- Absences -->
    <a asp-controller="Attendance" asp-action="StudentReport" class="group bg-gradient-to-br from-amber-500 to-amber-600 rounded-2xl shadow-lg p-6 text-white hover:scale-105 hover:shadow-2xl transition-all duration-300 no-underline">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-amber-100 text-sm font-medium mb-1">Devamsızlık</p>
                <h3 class="text-4xl font-bold">@Model.Attendances.Count(a => a.Status == "Absent")</h3>
            </div>
            <div class="text-6xl opacity-20 group-hover:opacity-30 transition-opacity">⚠️</div>
        </div>
        <div class="mt-4 pt-4 border-t border-amber-400">
            <span class="text-sm font-medium hover:text-amber-100 transition-colors">
                Devamsızlık Raporu →
            </span>
        </div>
    </a>
</div>

<!-- Courses & Exams Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- My Courses -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
            <h2 class="text-xl font-bold text-white">📚 Derslerim</h2>
        </div>
        <div class="p-6">
            @if (Model.Enrollments.Any())
            {
                <div class="space-y-3">
                    @foreach (var enrollment in Model.Enrollments)
                    {
                        <a href="@Url.Action("Details", "Courses", new { id = enrollment.CourseId })" class="block border-l-4 border-blue-500 pl-4 py-3 hover:bg-blue-50 rounded-r-lg transition-all duration-200 group">
                            <div class="flex justify-between items-start mb-2">
                                <h3 class="font-semibold text-gray-800 group-hover:text-blue-600 transition-colors">@enrollment.Course.Title</h3>
                                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-1 rounded">
                                    @enrollment.Course.Code
                                </span>
                            </div>
                            <p class="text-sm text-gray-600 mb-1">@enrollment.Course.Teacher?.ApplicationUser.FullName</p>
                            <p class="text-xs text-gray-500">@enrollment.Course.Credits Kredi</p>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <div class="text-6xl mb-4 opacity-20">📚</div>
                    <p class="text-gray-500">Henüz kayıtlı ders yok</p>
                </div>
            }
        </div>
    </div>

    <!-- Upcoming Exams -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
        <div class="bg-gradient-to-r from-emerald-500 to-emerald-600 px-6 py-4">
            <h2 class="text-xl font-bold text-white">📝 Yaklaşan Sınavlar</h2>
        </div>
        <div class="p-6">
            @if (upcomingExams != null && upcomingExams.Any())
            {
                <div class="space-y-3">
                    @foreach (var exam in upcomingExams)
                    {
                        <div class="border-l-4 border-emerald-500 pl-4 py-3 hover:bg-emerald-50 rounded-r-lg transition-colors duration-200">
                            <div class="flex justify-between items-start">
                                <div class="flex-1">
                                    <h3 class="font-semibold text-gray-800">@exam.Title</h3>
                                    <p class="text-sm text-gray-600 mt-1">@exam.Course.Title</p>
                                    <p class="text-xs text-gray-500 mt-1">@exam.ExamDate.ToString("HH:mm") - @exam.DurationMinutes dk</p>
                                </div>
                                <span class="text-sm font-medium text-red-600 ml-4">@exam.ExamDate.ToString("dd MMM")</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <div class="text-6xl mb-4 opacity-20">📝</div>
                    <p class="text-gray-500">Yaklaşan sınav yok</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Recent Grades -->
<div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
    <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-4 flex justify-between items-center">
        <h2 class="text-xl font-bold text-white">🎯 Son Notlarım</h2>
        <a asp-action="MyGrades" class="bg-white text-purple-600 px-3 py-1 rounded-lg text-sm font-medium hover:bg-purple-50 transition-colors">
            Tüm Notlar
        </a>
    </div>
    <div class="p-6">
        @if (Model.Grades.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b-2 border-gray-200">
                            <th class="text-left py-3 px-4 font-semibold text-gray-700">Sınav</th>
                            <th class="text-left py-3 px-4 font-semibold text-gray-700">Ders</th>
                            <th class="text-center py-3 px-4 font-semibold text-gray-700">Puan</th>
                            <th class="text-center py-3 px-4 font-semibold text-gray-700">Harf Notu</th>
                            <th class="text-right py-3 px-4 font-semibold text-gray-700">Tarih</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grade in Model.Grades.OrderByDescending(g => g.GradedAt).Take(5))
                        {
                            <tr class="border-b border-gray-100 hover:bg-purple-50 transition-colors">
                                <td class="py-3 px-4 text-gray-800">@grade.Exam.Title</td>
                                <td class="py-3 px-4 text-gray-600">@grade.Exam.Course.Title</td>
                                <td class="py-3 px-4 text-center font-semibold text-gray-800">@grade.Score.ToString("0.00")</td>
                                <td class="py-3 px-4 text-center">
                                    <span class="inline-block px-3 py-1 rounded-full text-sm font-medium @(grade.Letter == "A" || grade.Letter == "B" ? "bg-emerald-100 text-emerald-800" : grade.Letter == "F" ? "bg-red-100 text-red-800" : "bg-blue-100 text-blue-800")">
                                        @grade.Letter
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right text-gray-500 text-sm">@grade.GradedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <div class="text-6xl mb-4 opacity-20">🎯</div>
                <p class="text-gray-500">Henüz not girilmemiş</p>
            </div>
        }
    </div>
</div>
