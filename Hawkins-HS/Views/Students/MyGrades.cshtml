@model IEnumerable<Hawkins_HS.Models.Grade>

@{
    ViewData["Title"] = "Notlarım";
}

<div class="max-w-7xl mx-auto px-4 py-8">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Notlarım</h1>
            <p class="text-gray-500 mt-1">Sınav sonuçlarınız ve akademik performansınız</p>
        </div>
        <a asp-action="Dashboard"
           class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors">
            <i class="bi bi-arrow-left"></i> Dashboard'a Dön
        </a>
    </div>

    @if (Model.Any())
    {
        
            var averageScore = Model.Average(g => g.Score);
            var totalGrades = Model.Count();
            var aGrades = Model.Count(g => g.Letter == "A");
            var bGrades = Model.Count(g => g.Letter == "B");
            var cGrades = Model.Count(g => g.Letter == "C");
            var dGrades = Model.Count(g => g.Letter == "D");
            var fGrades = Model.Count(g => g.Letter == "F");
        

        <!-- Stats Row -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 text-center">
                <p class="text-3xl font-bold text-primary-600">@averageScore.ToString("0.00")</p>
                <p class="text-sm text-gray-500 mt-1">Ortalama Puan</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 text-center">
                <p class="text-3xl font-bold text-gray-800">@totalGrades</p>
                <p class="text-sm text-gray-500 mt-1">Toplam Sınav</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 text-center col-span-2">
                <p class="text-xs text-gray-500 uppercase tracking-wider mb-3 font-semibold">Harf Notu Dağılımı</p>
                <div class="flex items-center justify-center gap-2 flex-wrap">
                    <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-semibold">A: @aGrades</span>
                    <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-semibold">B: @bGrades</span>
                    <span class="px-3 py-1 bg-cyan-100 text-cyan-700 rounded-full text-sm font-semibold">C: @cGrades</span>
                    <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm font-semibold">D: @dGrades</span>
                    <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-semibold">F: @fGrades</span>
                </div>
            </div>
        </div>

        <!-- Grades Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100">
                <h2 class="text-lg font-semibold text-gray-800">Not Listesi</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-xs uppercase tracking-wider text-gray-500">
                            <th class="px-6 py-3 text-left">Ders</th>
                            <th class="px-6 py-3 text-left">Sınav</th>
                            <th class="px-6 py-3 text-left">Puan</th>
                            <th class="px-6 py-3 text-left">Harf Notu</th>
                            <th class="px-6 py-3 text-left">Değerlendirme Tarihi</th>
                            <th class="px-6 py-3 text-left">Sınav Tarihi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var grade in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4">
                                    <p class="font-semibold text-gray-900">@grade.Exam.Course.Title</p>
                                    <p class="text-xs text-gray-400">@grade.Exam.Course.Code</p>
                                </td>
                                <td class="px-6 py-4 text-gray-700">@grade.Exam.Title</td>
                                <td class="px-6 py-4">
                                    @{
                                        var scoreColor = grade.Score >= 85 ? "bg-green-100 text-green-700"
                                                       : grade.Score >= 70 ? "bg-blue-100 text-blue-700"
                                                       : grade.Score >= 50 ? "bg-yellow-100 text-yellow-700"
                                                       : "bg-red-100 text-red-700";
                                    }
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold @scoreColor">
                                        @grade.Score.ToString("0.00")
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    @{
                                        var letterColor = grade.Letter == "A" ? "bg-green-100 text-green-700"
                                                        : grade.Letter == "B" ? "bg-blue-100 text-blue-700"
                                                        : grade.Letter == "C" ? "bg-cyan-100 text-cyan-700"
                                                        : grade.Letter == "D" ? "bg-yellow-100 text-yellow-700"
                                                        : "bg-red-100 text-red-700";
                                    }
                                    <span class="px-3 py-1 rounded-full text-sm font-bold @letterColor">
                                        @grade.Letter
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-gray-500">@grade.GradedAt.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4 text-gray-500">@grade.Exam.ExamDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-16 text-center">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="bi bi-clipboard2-x text-primary-600 text-2xl"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-800 mb-2">Henüz Not Girilmemiş</h3>
            <p class="text-gray-500">Sınav sonuçlarınız açıklandıkça burada görünecektir.</p>
        </div>
    }
</div>
