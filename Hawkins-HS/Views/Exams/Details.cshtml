@model Hawkins_HS.Models.Exam

@{
    ViewData["Title"] = "Sınav Detayı";
    var daysUntil = (Model.ExamDate - DateTime.Now).Days;
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Exam Info Card -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="bg-gradient-to-r from-emerald-500 to-emerald-600 px-6 py-6 text-white flex justify-between items-start">
                <div>
                    <h1 class="text-3xl font-bold mb-2">📝 @Model.Title</h1>
                </div>
                <div class="flex gap-2">
                    @if (ViewBag.IsTeacherOfCourse == true)
                    {
                        <a asp-controller="Grades" asp-action="EnterGrades" asp-route-id="@Model.Id" class="bg-white text-emerald-600 px-4 py-2 rounded-lg hover:bg-emerald-50 transition-colors font-medium">
                            Not Gir
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-amber-500 text-white px-4 py-2 rounded-lg hover:bg-amber-600 transition-colors font-medium">
                            Düzenle
                        </a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" onclick="return confirm('Bu sınavı silmek istediğinizden emin misiniz?')" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition-colors font-medium">
                            Sil
                        </a>
                    }
                </div>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="bg-blue-50 rounded-lg p-4">
                        <p class="text-sm text-gray-600 mb-1">📚 Ders</p>
                        <h3 class="font-bold text-gray-800 text-lg">@Model.Course.Title</h3>
                        <span class="inline-block mt-2 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
                            @Model.Course.Code
                        </span>
                    </div>
                    <div class="bg-purple-50 rounded-lg p-4">
                        <p class="text-sm text-gray-600 mb-1">👨‍🏫 Öğretmen</p>
                        <h3 class="font-bold text-gray-800 text-lg">
                            @Model.Course.Teacher?.ApplicationUser.FullName
                        </h3>
                    </div>
                </div>

                <div class="border-t border-gray-200 my-6"></div>

                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="bg-amber-50 rounded-lg p-4">
                        <p class="text-sm text-gray-600 mb-1">📅 Sınav Tarihi</p>
                        <p class="font-semibold text-gray-800">@Model.ExamDate.ToString("dd MMMM yyyy, dddd")</p>
                        <p class="text-amber-600 font-bold text-xl mt-2">@Model.ExamDate.ToString("HH:mm")</p>
                    </div>
                    <div class="bg-emerald-50 rounded-lg p-4">
                        <p class="text-sm text-gray-600 mb-1">⏱️ Süre</p>
                        <p class="text-emerald-600 font-bold text-3xl">@Model.DurationMinutes</p>
                        <p class="text-gray-600 text-sm">dakika</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="border-t border-gray-200 my-6"></div>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">📋 Açıklama</h3>
                        <p class="text-gray-600 whitespace-pre-wrap">@Model.Description</p>
                    </div>
                }

                <div class="border-t border-gray-200 my-6"></div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-3 gap-4">
                    <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl p-6 text-white text-center hover:scale-105 transition-transform">
                        <h3 class="text-4xl font-bold mb-2">@Model.Grades.Count</h3>
                        <p class="text-blue-100">Not Girildi</p>
                    </div>
                    <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl p-6 text-white text-center hover:scale-105 transition-transform">
                        <h3 class="text-4xl font-bold mb-2">
                            @if (Model.Grades.Any())
                            {
                                @Model.Grades.Average(g => g.Score).ToString("0.00")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </h3>
                        <p class="text-emerald-100">Ortalama</p>
                    </div>
                    <div class="bg-gradient-to-br from-@(daysUntil < 0 ? "gray" : daysUntil <= 7 ? "red" : "purple")-500 to-@(daysUntil < 0 ? "gray" : daysUntil <= 7 ? "red" : "purple")-600 rounded-xl p-6 text-white text-center hover:scale-105 transition-transform">
                        <h3 class="text-4xl font-bold mb-2">
                            @if (daysUntil < 0)
                            {
                                <i class="bi bi-check-circle"></i>
                            }
                            else
                            {
                                @daysUntil
                            }
                        </h3>
                        <p class="text-white/80">@(daysUntil < 0 ? "Geçti" : "Gün Kaldı")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar - Grades -->
    <div class="lg:col-span-1">
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow sticky top-4">
            <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-4">
                <h2 class="text-xl font-bold text-white">📊 Notlar</h2>
            </div>
            <div class="p-4 max-h-96 overflow-y-auto">
                @if (Model.Grades.Any())
                {
                    <div class="space-y-2">
                        @foreach (var grade in Model.Grades.OrderByDescending(g => g.Score))
                        {
                            <div class="bg-gray-50 rounded-lg p-3 hover:bg-purple-50 transition-colors">
                                <div class="flex justify-between items-start">
                                    <div class="flex-1">
                                        <p class="font-semibold text-gray-800 text-sm">@grade.Student.ApplicationUser.FullName</p>
                                        <p class="text-xs text-gray-500 mt-1">@grade.Student.StudentNumber</p>
                                    </div>
                                    <div class="text-right ml-2">
                                        <span class="inline-block px-3 py-1 rounded-lg text-sm font-bold @(grade.Letter == "A" || grade.Letter == "B" ? "bg-emerald-100 text-emerald-800" : grade.Letter == "F" ? "bg-red-100 text-red-800" : "bg-blue-100 text-blue-800")">
                                            @grade.Score.ToString("0.00")
                                        </span>
                                        <p class="text-xs text-gray-500 mt-1">@grade.Letter</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8">
                        <div class="text-5xl mb-3 opacity-20">📊</div>
                        <p class="text-gray-500 text-sm">Henüz not girilmemiş</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Back Button -->
<div class="mt-6">
    <a asp-action="Index" class="inline-flex items-center px-6 py-3 bg-gray-500 text-white rounded-xl hover:bg-gray-600 transition-colors font-medium">
        <i class="bi bi-arrow-left mr-2"></i> Sınavlara Geri Dön
    </a>
</div>
