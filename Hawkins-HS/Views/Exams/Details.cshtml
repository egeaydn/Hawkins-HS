@model Hawkins_HS.Models.Exam

@{
    ViewData["Title"] = "Sınav Detayı";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">📝 @Model.Title</h4>
                        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                        {
                            <div class="btn-group">
                                <a asp-controller="Grades" asp-action="EnterGrades" asp-route-id="@Model.Id" class="btn btn-success btn-sm">Not Gir</a>
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light btn-sm">Düzenle</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm" 
                                       onclick="return confirm('Bu sınavı silmek istediğinizden emin misiniz?')">Sil</a>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Ders</h6>
                            <h5>@Model.Course.Title</h5>
                            <span class="badge bg-primary">@Model.Course.Code</span>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Öğretmen</h6>
                            <h5>@Model.Course.Teacher?.ApplicationUser.FullName</h5>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">📅 Sınav Tarihi</h6>
                            <p class="mb-0">@Model.ExamDate.ToString("dd MMMM yyyy, dddd")</p>
                            <p class="text-primary"><strong>@Model.ExamDate.ToString("HH:mm")</strong></p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">⏱️ Süre</h6>
                            <p><strong>@Model.DurationMinutes dakika</strong></p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <hr />
                        <div class="mb-3">
                            <h6 class="text-muted">📋 Açıklama</h6>
                            <p style="white-space: pre-wrap;">@Model.Description</p>
                        </div>
                    }

                    <hr />

                    <div class="row">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-primary">@Model.Grades.Count</h3>
                                    <p class="mb-0 text-muted">Not Girildi</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-success">
                                        @if (Model.Grades.Any())
                                        {
                                            @Model.Grades.Average(g => g.Score).ToString("0.00")
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </h3>
                                    <p class="mb-0 text-muted">Ortalama</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    @{
                                        var daysUntil = (Model.ExamDate - DateTime.Now).Days;
                                    }
                                    <h3 class="@(daysUntil < 0 ? "text-secondary" : daysUntil <= 7 ? "text-danger" : "text-info")">
                                        @if (daysUntil < 0)
                                        {
                                            <span>Geçti</span>
                                        }
                                        else
                                        {
                                            @daysUntil
                                        }
                                    </h3>
                                    <p class="mb-0 text-muted">@(daysUntil < 0 ? "" : "Gün Kaldı")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">📊 Notlar</h5>
                </div>
                <div class="card-body">
                    @if (Model.Grades.Any())
                    {
                        <div class="list-group">
                            @foreach (var grade in Model.Grades.OrderByDescending(g => g.Score))
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@grade.Student.ApplicationUser.FullName</strong>
                                            <br />
                                            <small class="text-muted">@grade.Student.StudentNumber</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-@(grade.Letter == "A" ? "success" : grade.Letter == "F" ? "danger" : "primary") fs-6">
                                                @grade.Score.ToString("0.00")
                                            </span>
                                            <br />
                                            <span class="badge bg-secondary">@grade.Letter</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">Henüz not girilmemiş</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Sınavlara Geri Dön</a>
    </div>
</div>
