@model IEnumerable<Hawkins_HS.ViewModels.ExamViewModel>

@{
    ViewData["Title"] = "Sınavlar";
}

<!-- Header -->
<div class="bg-gradient-to-r from-primary-600 to-primary-700 text-white py-12 px-4 sm:px-6 lg:px-8 mb-8 rounded-2xl shadow-xl">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
        <div>
            <h1 class="text-4xl font-bold mb-2 animate-pulse-slow">📝 Sınavlar</h1>
            <p class="text-primary-100">Tüm sınav takvimi</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
        {
            <a asp-action="Create" class="bg-white text-primary-700 px-6 py-3 rounded-xl font-semibold hover:scale-105 hover:shadow-xl transition-all duration-300">
                Yeni Sınav Oluştur
            </a>
        }
    </div>
</div>

<!-- Exams Grid -->
@if (Model.Any())
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var exam in Model.OrderBy(e => e.ExamDate))
        {
            var isPast = exam.ExamDate < DateTime.Now;
            var daysUntil = (exam.ExamDate - DateTime.Now).Days;
            
            <div class="group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl hover:scale-105 transition-all duration-300">
                <!-- Card Header -->
                <div class="@(isPast ? "bg-gradient-to-r from-gray-500 to-gray-600" : "bg-gradient-to-r from-emerald-500 to-emerald-600") px-6 py-4 text-white">
                    <h3 class="text-xl font-bold">@exam.Title</h3>
                </div>

                <!-- Card Body -->
                <div class="p-6">
                    <h4 class="text-primary-700 font-semibold text-lg mb-4">@exam.CourseName</h4>
                    
                    <div class="space-y-3 mb-4">
                        <div class="flex items-start">
                            <i class="bi bi-calendar-event text-blue-500 text-xl mr-3 mt-1"></i>
                            <div>
                                <span class="text-sm text-gray-500 block">Tarih</span>
                                <p class="font-medium text-gray-800">@exam.ExamDate.ToString("dd MMMM yyyy, HH:mm")</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start">
                            <i class="bi bi-clock text-amber-500 text-xl mr-3 mt-1"></i>
                            <div>
                                <span class="text-sm text-gray-500 block">Süre</span>
                                <p class="font-medium text-gray-800">@exam.DurationMinutes dakika</p>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(exam.Description))
                        {
                            <div class="flex items-start">
                                <i class="bi bi-file-text text-purple-500 text-xl mr-3 mt-1"></i>
                                <div class="flex-1">
                                    <span class="text-sm text-gray-500 block">Açıklama</span>
                                    <p class="font-medium text-gray-800 line-clamp-2">@exam.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <!-- Status Badge -->
                    <div class="mb-4">
                        @if (isPast)
                        {
                            <span class="inline-block px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                                <i class="bi bi-check-circle"></i> Geçmiş
                            </span>
                        }
                        else
                        {
                            if (daysUntil == 0)
                            {
                                <span class="inline-block px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-medium animate-pulse">
                                    <i class="bi bi-exclamation-circle"></i> Bugün
                                </span>
                            }
                            else if (daysUntil <= 7)
                            {
                                <span class="inline-block px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-sm font-medium">
                                    <i class="bi bi-hourglass-split"></i> @daysUntil gün kaldı
                                </span>
                            }
                            else
                            {
                                <span class="inline-block px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">
                                    <i class="bi bi-calendar-check"></i> @daysUntil gün kaldı
                                </span>
                            }
                        }
                    </div>
                </div>

                <!-- Card Footer -->
                <div class="px-6 pb-6">
                    <div class="flex flex-wrap gap-2">
                        <a asp-action="Details" asp-route-id="@exam.Id" class="flex-1 text-center bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-colors font-medium">
                            Detaylar
                        </a>
                        @if (ViewBag.IsAdmin == true || (ViewBag.CurrentTeacherUserName != null && ViewBag.CurrentTeacherUserName == exam.TeacherUserName))
                        {
                            <a asp-action="Edit" asp-route-id="@exam.Id" class="flex-1 text-center bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors font-medium">
                                Düzenle
                            </a>
                        }
                        @if (ViewBag.IsAdmin == true)
                        {
                            <a asp-action="Delete" asp-route-id="@exam.Id" onclick="return confirm('Bu sınavı silmek istediğinizden emin misiniz?')" class="flex-1 text-center bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition-colors font-medium">
                                Sil
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="bg-blue-50 border-l-4 border-blue-500 rounded-xl p-8 text-center max-w-2xl mx-auto">
        <div class="text-6xl mb-4 opacity-30">📝</div>
        <h4 class="text-2xl font-bold text-gray-800 mb-2">Henüz sınav oluşturulmamış</h4>
        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
        {
            <p class="text-gray-600">Yeni bir sınav oluşturmak için yukarıdaki butona tıklayın.</p>
        }
    </div>
}
</div>
