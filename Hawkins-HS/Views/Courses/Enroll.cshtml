@{
    ViewData["Title"] = "Öğrenci Kaydet";
    var course = ViewBag.Course as Hawkins_HS.Models.Course;
    var availableStudents = ViewBag.AvailableStudents as IEnumerable<dynamic>;
}

<!-- Header -->
<div class="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white py-12 px-4 sm:px-6 lg:px-8 mb-8 rounded-2xl shadow-xl">
    <div class="max-w-5xl mx-auto">
        <h1 class="text-4xl font-bold mb-2 animate-pulse-slow">👨‍🎓 Derse Öğrenci Kaydet</h1>
        <p class="text-emerald-100">Öğrencileri derse kaydedebilirsiniz</p>
    </div>
</div>

<div class="max-w-5xl mx-auto">
    <!-- Course Info -->
    <div class="bg-blue-50 border-l-4 border-blue-500 rounded-xl p-6 mb-8">
        <h2 class="text-2xl font-bold text-gray-800 mb-2">📚 @course.Title</h2>
        <p class="text-gray-600">
            <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                @course.Code
            </span>
            <span class="ml-3 text-sm">Bu derse kayıt olmamış öğrencileri aşağıdan seçerek kaydedebilirsiniz.</span>
        </p>
    </div>

    @if (availableStudents.Any())
    {
        <!-- Form Card -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div class="bg-gradient-to-r from-emerald-500 to-emerald-600 px-6 py-4">
                <h3 class="text-xl font-bold text-white">Öğrenci Seçimi</h3>
            </div>
            <div class="p-6">
                <form asp-action="EnrollStudent" method="post" id="enrollForm">
                    <input type="hidden" name="courseId" value="@course.Id" />
                    
                    <!-- Quick Select Dropdown -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">
                            <i class="bi bi-person-plus-fill mr-2 text-emerald-500"></i>Hızlı Seçim
                        </label>
                        <select name="studentId" 
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all text-lg" 
                                required>
                            <option value="">-- Öğrenci Seçin --</option>
                            @foreach (var student in availableStudents)
                            {
                                <option value="@student.Id">
                                    @student.Name - @student.StudentNumber (@student.ClassName)
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Students Table -->
                    <div class="mb-6">
                        <h4 class="text-lg font-semibold text-gray-800 mb-4">
                            <i class="bi bi-table mr-2 text-purple-500"></i>Tüm Uygun Öğrenciler
                        </h4>
                        <div class="overflow-x-auto rounded-xl border border-gray-200">
                            <table class="w-full">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Öğrenci No</th>
                                        <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Ad Soyad</th>
                                        <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Sınıf</th>
                                        <th class="px-6 py-4 text-center text-xs font-bold text-gray-700 uppercase tracking-wider">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    @foreach (var student in availableStudents)
                                    {
                                        <tr class="hover:bg-emerald-50 transition-colors">
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                                @student.StudentNumber
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                                @student.Name
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs font-medium">
                                                    @student.ClassName
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                                <button type="button" 
                                                        class="enroll-btn bg-emerald-500 text-white px-4 py-2 rounded-lg hover:bg-emerald-600 transition-colors font-medium text-sm"
                                                        data-student-id="@student.Id" 
                                                        data-student-name="@student.Name">
                                                    <i class="bi bi-check-circle mr-1"></i>Kaydet
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex justify-between items-center pt-6 border-t border-gray-200">
                        <a asp-action="Details" asp-route-id="@course.Id" 
                           class="px-6 py-3 bg-gray-500 text-white rounded-xl hover:bg-gray-600 transition-colors font-medium">
                            <i class="bi bi-arrow-left mr-2"></i>Derse Geri Dön
                        </a>
                        <button type="submit" 
                                class="px-8 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-xl hover:from-emerald-600 hover:to-emerald-700 transition-all font-semibold shadow-lg hover:shadow-xl transform hover:scale-105">
                            <i class="bi bi-check-circle mr-2"></i>Seçili Öğrenciyi Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- No Students Available -->
        <div class="bg-emerald-50 border-l-4 border-emerald-500 rounded-xl p-8 text-center">
            <div class="text-6xl mb-4 opacity-30">✅</div>
            <h3 class="text-2xl font-bold text-gray-800 mb-2">Tüm Öğrenciler Kayıtlı</h3>
            <p class="text-gray-600 mb-6">Bu derse kayıt olmamış öğrenci kalmadı.</p>
            <a asp-action="Details" asp-route-id="@course.Id" 
               class="inline-block px-8 py-3 bg-blue-500 text-white rounded-xl hover:bg-blue-600 transition-colors font-semibold">
                <i class="bi bi-arrow-left mr-2"></i>Derse Geri Dön
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Tablodaki butonlarla hızlı kayıt
        document.querySelectorAll('.enroll-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const studentId = this.dataset.studentId;
                const studentName = this.dataset.studentName;
                
                if (confirm(studentName + ' adlı öğrenciyi derse kaydetmek istediğinizden emin misiniz?')) {
                    document.querySelector('select[name="studentId"]').value = studentId;
                    document.getElementById('enrollForm').submit();
                }
            });
        });
    </script>
}
