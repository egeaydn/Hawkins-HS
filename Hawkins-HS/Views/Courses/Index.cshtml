@model IEnumerable<Hawkins_HS.ViewModels.CourseViewModel>

@{
    ViewData["Title"] = "Dersler";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Yeni Ders Ekle
            </a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">@item.Title</h5>
                        <small>@item.Code</small>
                    </div>
                    <div class="card-body">
                        <p class="card-text text-muted">@(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                        
                        <div class="mb-2">
                            <strong>Öğretmen:</strong> @item.TeacherName
                        </div>
                        <div class="mb-2">
                            <strong>Kredi:</strong> @item.Credits
                        </div>
                        <div class="mb-2">
                            <strong>Kayıtlı Öğrenci:</strong> @item.EnrolledStudents
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="btn-group w-100" role="group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detaylar</a>
                            
                            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            }
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <h4>Henüz ders bulunmuyor</h4>
            <p>İlk dersinizi oluşturmak için "Yeni Ders Ekle" butonuna tıklayın.</p>
        </div>
    }
</div>
