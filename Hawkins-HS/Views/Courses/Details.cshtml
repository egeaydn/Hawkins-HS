@model Hawkins_HS.Models.Course

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Dersler</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@Model.Title (@Model.Code)</h4>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Açıklama:</strong>
                        <p class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "Açıklama bulunmuyor" : Model.Description)</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong>Öğretmen:</strong><br />
                            @(Model.Teacher != null ? Model.Teacher.ApplicationUser.FullName : "Atanmamış")
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Kredi:</strong><br />
                            @Model.Credits
                        </div>
                    </div>

                    <div class="mt-3">
                        @if (ViewBag.IsTeacherOfCourse == true)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
                            <a asp-action="Enroll" asp-route-id="@Model.Id" class="btn btn-success">Öğrenci Kaydet</a>
                            <a asp-controller="Schedule" asp-action="Manage" asp-route-id="@Model.Id" class="btn btn-primary">Program Yönet</a>
                            <a asp-controller="Attendance" asp-action="TakeAttendance" asp-route-id="@Model.Id" class="btn btn-info">Yoklama Al</a>
                            <a asp-controller="Attendance" asp-action="CourseReport" asp-route-id="@Model.Id" class="btn btn-secondary">Devamsızlık Raporu</a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Sil</a>
                        }
                    </div>
                </div>
            </div>

            <!-- Ders Programı -->
            @if (Model.ClassSchedules.Any())
            {
                <div class="card shadow mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">📅 Ders Programı</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Gün</th>
                                    <th>Saat</th>
                                    <th>Sınıf</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var schedule in Model.ClassSchedules.OrderBy(s => s.Day))
                                {
                                    <tr>
                                        <td>@schedule.Day</td>
                                        <td>@schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")</td>
                                        <td>@schedule.Room</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Sınavlar -->
            @if (Model.Exams.Any())
            {
                <div class="card shadow mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">📝 Sınavlar</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group">
                            @foreach (var exam in Model.Exams.OrderBy(e => e.ExamDate))
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@exam.Title</h6>
                                            <p class="mb-1 text-muted">@exam.Description</p>
                                            <small>Süre: @exam.DurationMinutes dakika</small>
                                        </div>
                                        <div class="text-end">
                                            <small class="d-block">@exam.ExamDate.ToString("dd MMM yyyy HH:mm")</small>
                                            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                                            {
                                                <a href="@Url.Action("EnterGrades", "Grades", new { id = exam.Id })" class="btn btn-success btn-sm mt-1">
                                                    Not Gir
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <!-- Kayıtlı Öğrenciler -->
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="mb-0">👥 Kayıtlı Öğrenciler (@Model.Enrollments.Count)</h5>
                </div>
                <div class="card-body">
                    @if (Model.Enrollments.Any())
                    {
                        <ul class="list-group">
                            @foreach (var enrollment in Model.Enrollments.OrderBy(e => e.Student.ApplicationUser.FullName))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@enrollment.Student.ApplicationUser.FullName</strong><br />
                                        <small class="text-muted">@enrollment.Student.StudentNumber | @enrollment.Student.ClassName</small>
                                    </div>
                                    <span class="badge bg-primary rounded-pill">@enrollment.Status</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted text-center">Henüz kayıtlı öğrenci yok</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
