@model Hawkins_HS.ViewModels.CourseViewModel

@{
    ViewData["Title"] = "Ders Düzenle";
}

<!-- Header -->
<div class="bg-gradient-to-r from-amber-600 to-amber-700 text-white py-12 px-4 sm:px-6 lg:px-8 mb-8 rounded-2xl shadow-xl">
    <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl font-bold mb-2 animate-pulse-slow">📝 Ders Düzenle</h1>
        <p class="text-amber-100">Ders bilgilerini güncelleyin</p>
    </div>
</div>

<!-- Form Card -->
<div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="p-8">
            <form asp-action="Edit" method="post" class="space-y-6">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="bg-red-50 border-l-4 border-red-500 p-4 rounded" role="alert"></div>
                
                <!-- Title Field -->
                <div>
                    <label asp-for="Title" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="bi bi-book mr-2 text-blue-500"></i>Ders Adı
                    </label>
                    <input asp-for="Title" 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" 
                           placeholder="Örn: İleri Matematik" />
                    <span asp-validation-for="Title" class="text-red-500 text-sm mt-1 block"></span>
                </div>

                <!-- Code Field -->
                <div>
                    <label asp-for="Code" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="bi bi-tag mr-2 text-purple-500"></i>Ders Kodu
                    </label>
                    <input asp-for="Code" 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" 
                           placeholder="Örn: MAT301" />
                    <span asp-validation-for="Code" class="text-red-500 text-sm mt-1 block"></span>
                    <p class="text-xs text-gray-500 mt-2">Format: 3 harf + 3 rakam (örn: MAT301)</p>
                </div>

                <!-- Description Field -->
                <div>
                    <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="bi bi-text-paragraph mr-2 text-emerald-500"></i>Açıklama
                    </label>
                    <textarea asp-for="Description" 
                              rows="4"
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all resize-none"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-sm mt-1 block"></span>
                </div>

                <!-- Credits and Teacher Row -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Credits -->
                    <div>
                        <label asp-for="Credits" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="bi bi-star mr-2 text-amber-500"></i>Kredi
                        </label>
                        <input asp-for="Credits" 
                               type="number" 
                               min="1" 
                               max="8"
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" />
                        <span asp-validation-for="Credits" class="text-red-500 text-sm mt-1 block"></span>
                    </div>

                    <!-- Teacher -->
                    <div>
                        <label asp-for="TeacherId" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="bi bi-person-badge mr-2 text-blue-500"></i>Öğretmen
                        </label>
                        <select asp-for="TeacherId" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                            <option value="">-- Öğretmen Seçin --</option>
                            @foreach (var teacher in ViewBag.Teachers)
                            {
                                <option value="@teacher.Id">@teacher.Name</option>
                            }
                        </select>
                        <span asp-validation-for="TeacherId" class="text-red-500 text-sm mt-1 block"></span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-between items-center pt-6 border-t border-gray-200">
                    <a asp-action="Details" asp-route-id="@Model.Id" 
                       class="px-6 py-3 bg-gray-500 text-white rounded-xl hover:bg-gray-600 transition-colors font-medium">
                        <i class="bi bi-x-circle mr-2"></i>İptal
                    </a>
                    <button type="submit" 
                            class="px-8 py-3 bg-gradient-to-r from-amber-500 to-amber-600 text-white rounded-xl hover:from-amber-600 hover:to-amber-700 transition-all font-semibold shadow-lg hover:shadow-xl transform hover:scale-105">
                        <i class="bi bi-check-circle mr-2"></i>Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
